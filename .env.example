# Copy to .env and adjust for your environment.

# Postgres
POSTGRES_DB=kittytask
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Backend auth — MUST be a long random string in production (>= 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Public origin the app is served from (used for CORS).
# Local: http://localhost:8080   Production: https://kittytask.hamzaalsafi.com
APP_ORIGIN=http://localhost:8080

# Host port the Caddy proxy listens on.
APP_PORT=8080
